{
  "name": "aircode",
  "productName": "AirCode",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面端 —— Electron 外壳内嵌完整 DSH WebUI，一键安装内核、独立运行",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "author": "DeepSeek Harness Desktop Contributors",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "electron-vite build && electron-builder",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "icons": "tsx scripts/gen-icons.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}