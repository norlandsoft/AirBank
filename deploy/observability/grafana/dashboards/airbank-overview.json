{
  "title": "AirBank 全局概览",
  "uid": "airbank-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP QPS（按服务）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP P95 耗时（秒）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "核心交易量（按类型/结果）",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (txn_type, result) (rate(airbank_txn_total[5m]))", "legendFormat": "{{txn_type}}/{{result}}" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "5 分钟错误率",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "JVM 存活实例",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "targets": [
        { "expr": "count(up == 1)", "legendFormat": "up" }
      ]
    }
  ]
}
